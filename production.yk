struct Vec<T> {
    data: [T],
    len: i32,
    cap: i32,
}

fn Vec_new<T>(default_val: T) -> Vec<T> {
    let mut data = alloc_array(2);
    data[0] = default_val;
    return Vec {
        data: data,
        len: 0,
        cap: 2
    };
}

fn Vec_push<T>(v: &mut Vec<T>, val: T) {
    if v.len == v.cap {
        let new_cap = v.cap * 2;
        let mut new_data = alloc_array(new_cap);
        let mut i = 0;
        while i < v.len {
            new_data[i] = v.data[i];
            i = i + 1;
        }
        v.data = new_data;
        v.cap = new_cap;
    }
    v.data[v.len] = val;
    v.len = v.len + 1;
}

fn Vec_get<T>(v: &Vec<T>, index: i32) -> T {
    return v.data[index];
}

// --- Предметная область: Завод ---

struct Product {
    id: i32,
    weight: i32,
    is_defective: i32,
}

struct Factory {
    name: String,
    inventory: Vec<Product>,
    defects_count: i32,
}

fn simulate_production(iterations: i32) -> Factory {
    // Инициализация дженерика заглушкой (из-за отсутствия явных <T> в вызовах)
    let dummy = Product { id: 0, weight: 0, is_defective: 0 };
    let mut inv = Vec_new(dummy);
    
    let mut f = Factory {
        name: "CyberZavod-2026",
        inventory: inv,
        defects_count: 0
    };

    let mut i = 1;
    while i <= iterations {
        // Симуляция брака: каждая третья деталь бракованная
        let mut defect = 0;
        let div = i / 3;
        if div * 3 == i {
            defect = 1;
            f.defects_count = f.defects_count + 1;
        }

        let p = Product {
            id: i,
            weight: i * 10,
            is_defective: defect
        };

        Vec_push(&mut f.inventory, p);
        i = i + 1;
    }

    return f;
}

fn telemetry_worker() -> i32 {
    sleep(15);
    println("[Фоновый Поток] Датчики в норме. Температура цеха: 22C");
    return 0;
}

fn main() -> i32 {
    println("--- Запуск производственной линии ---");
    spawn("telemetry_worker");
    
    let batch_size = 10;
    let mut factory = simulate_production(batch_size);
    
    println("Производство завершено. Цех:");
    println(factory.name);
    
    let mut i = 0;
    let inv_len = factory.inventory.len;
    
    println("--- Список годных деталей (ID) ---");
    while i < inv_len {
        let p = Vec_get(&factory.inventory, i);
        if p.is_defective == 0 {
            println(p.id);
        }
        i = i + 1;
    }
    
    println("--- Количество отбракованных деталей ---");
    println(factory.defects_count);
    
    println("--- Завершение работы конвейера ---");
    return 0;
}
