{
  "name": "vscode-apl",
  "displayName": "Young Kazah Language (YKL / APL) Support",
  "description": "Official VS Code syntax highlighting & LSP support for Young Kazah Language",
  "version": "0.1.0",
  "publisher": "young-kazah",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ykl",
        "aliases": ["Young Kazah", "YKL", "APL"],
        "extensions": [".yk", ".apl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ykl",
        "scopeName": "source.ykl",
        "path": "./syntaxes/ykl.tmLanguage.json"
      }
    ]
  }
}
