struct Account {
    id: int
    balance: int

    fn calculate_balance(&self, bonus: int) -> int {
        return self.balance + bonus
    }
}

fn main() -> int {
    println("=== YKL 2.0: println + struct methods + native build ===")
    acc := Account { id: 1, balance: 1500 }
    total := acc.calculate_balance(500)
    print("Account balance: ")
    println(total)
    return 0
}
