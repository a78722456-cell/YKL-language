// ==========================================
// YKL 2.0 Backend Service Engine
// Micro-banking & Transaction Pipeline
// ==========================================

struct Account {
    id: int
    balance: int
    is_active: bool

    fn deposit(&mut self, amount: int) -> bool {
        if amount <= 0 {
            return false
        }
        self.balance = self.balance + amount
        return true
    }

    fn withdraw(&mut self, amount: int) -> bool {
        if amount <= 0 {
            return false
        }
        if self.balance < amount {
            return false
        }
        self.balance = self.balance - amount
        return true
    }
}

fn transfer(sender: &mut Account, recipient: &mut Account, amount: int) -> bool {
    if !sender.is_active {
        println("Ошибка: Счёт отправителя заблокирован")
        return false
    }
    if !recipient.is_active {
        println("Ошибка: Счёт получателя заблокирован")
        return false
    }
    if sender.withdraw(amount) {
        recipient.deposit(amount)
        println("Успешный перевод средств!")
        return true
    } else {
        println("Ошибка: Недостаточно средств на балансе")
        return false
    }
}

fn main() -> int {
    println("=== YKL 2.0 Fintech Core Engine ===")

    acc1 := Account { id: 101, balance: 15000, is_active: true }
    acc2 := Account { id: 102, balance: 4200, is_active: true }

    // Auto-borrowing: передача по ссылке без явных &mut
    transfer(acc1, acc2, 3500)

    print("Баланс аккаунта 101: ")
    println(acc1.balance)
    print("Баланс аккаунта 102: ")
    println(acc2.balance)

    return 0
}
