// ============================================================================
// Young Kazah Language (YKL 2.0) - Non-Lexical Lifetimes (NLL) Borrow Checker
// ============================================================================
// Демонстрация работы статического анализатора заимствований (Borrow Checker):
// - `y` заимствует `x` изменяемо (&mut).
// - Затем `x` безопасно модифицируется, так как анализ потока данных (liveness dataflow)
//   доказывает, что время жизни ссылки `y` закончилось (NLL).
// - Нулевые накладные расходы во время выполнения (0 байт в куче, без GC).
// ============================================================================

fn main() -> int {
    println("=== YKL 2.0 Non-Lexical Lifetimes (NLL) Proof ===")

    x := 10
    
    // y заимствует x мутабельно
    y := &mut x
    
    // NLL: время жизни ссылки y завершилось здесь, так как y больше не используется.
    // Статический анализатор YKL безопасно разрешает мутацию x:
    x = 42
    
    print("Результат x: ")
    println(x)

    return 0
}
