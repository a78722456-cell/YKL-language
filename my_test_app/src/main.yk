package main
fn is_even(number: i32) -> bool {
    if number % 2 == 0 {
        return true;
    } else {
        return false;
    }
}
fn main() -> i32 {
    let msg = "Hello from YKL!";
    println(msg);
    
    let mut counter = 10;
    
    if is_even(counter) {
        println("The counter is EVEN");
    } else {
        println("The counter is ODD");
    }
    
    return 0;
}