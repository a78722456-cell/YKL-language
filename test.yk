fn main() -> i32 {
    let initialized = 10;
    let mut target = 0;
    let mut flag = true;
    
    if initialized > 5 {
        target = initialized;
    } else {
        target = 20;
    }
    
    while flag {
        if target > 100 {
            flag = false;
        }
        target = target + 1;
    }
    
    target
}